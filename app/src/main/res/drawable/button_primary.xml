<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="0"
                android:endColor="#1CA996"
                android:startColor="#E85757" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:endColor="@color/dda_teal"
                android:startColor="@color/dda_primary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
