<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/guideRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_canvas"
    tools:context=".CreativeGuideActivity">

    <com.susnatacodes.digitaldrawingassist.SketchBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/guideContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/guideAppBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/guideToolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/dda_ink"
                app:title="@string/open_creative_guide"
                app:titleCentered="false"
                app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/guideScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/guideEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_dark"
                    android:fontFamily="sans-serif"
                    android:textFontWeight="500"
                    tools:targetApi="28"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/guide_eyebrow"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/guideTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif"
                    android:textFontWeight="900"
                    android:textStyle="bold"
                    tools:targetApi="28"
                    android:letterSpacing="0"
                    android:text="@string/guide_title"
                    android:textColor="@color/dda_ink"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/guideSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/guide_subtitle"
                    android:textColor="@color/dda_muted"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/guideHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/card_deep"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textFontWeight="900"
                        android:textStyle="bold"
                        tools:targetApi="28"
                        android:text="@string/guide_hero_title"
                        android:textColor="@color/white"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/guide_hero_body"
                        android:textColor="#D8FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/guideStepOne"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/guide_step_card"
                    android:lineSpacingExtra="3dp"
                    android:padding="14dp"
                    android:text="@string/guide_step_one"
                    android:textColor="@color/dda_ink"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/guideStepTwo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/guide_step_card"
                    android:lineSpacingExtra="3dp"
                    android:padding="14dp"
                    android:text="@string/guide_step_two"
                    android:textColor="@color/dda_ink"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/guideStepThree"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/guide_step_card"
                    android:lineSpacingExtra="3dp"
                    android:padding="14dp"
                    android:text="@string/guide_step_three"
                    android:textColor="@color/dda_ink"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/guideStepFour"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/guide_step_card"
                    android:lineSpacingExtra="3dp"
                    android:padding="14dp"
                    android:text="@string/guide_step_four"
                    android:textColor="@color/dda_ink"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnGuideBack"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/button_primary"
                    android:fontFamily="sans-serif"
                    android:textFontWeight="500"
                    tools:targetApi="28"
                    android:text="@string/back_to_studio"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</FrameLayout>
