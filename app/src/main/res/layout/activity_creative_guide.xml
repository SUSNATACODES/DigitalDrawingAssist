<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_canvas">

    <com.susnatacodes.digitaldrawingassist.SketchBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="34dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/guideEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_dark"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:text="@string/guide_eyebrow"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/guideTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0"
                android:text="@string/guide_title"
                android:textColor="@color/dda_ink"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/guideSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/guide_subtitle"
                android:textColor="@color/dda_muted"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/guideHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/card_deep"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/guide_hero_title"
                    android:textColor="@color/white"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/guide_hero_body"
                    android:textColor="#D8FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/guideStepOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/guide_step_card"
                android:lineSpacingExtra="3dp"
                android:padding="15dp"
                android:text="@string/guide_step_one"
                android:textColor="@color/dda_ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/guideStepTwo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/guide_step_card"
                android:lineSpacingExtra="3dp"
                android:padding="15dp"
                android:text="@string/guide_step_two"
                android:textColor="@color/dda_ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/guideStepThree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/guide_step_card"
                android:lineSpacingExtra="3dp"
                android:padding="15dp"
                android:text="@string/guide_step_three"
                android:textColor="@color/dda_ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/guideStepFour"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/guide_step_card"
                android:lineSpacingExtra="3dp"
                android:padding="15dp"
                android:text="@string/guide_step_four"
                android:textColor="@color/dda_ink"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGuideBack"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/button_primary"
                android:fontFamily="sans-serif-medium"
                android:text="@string/back_to_studio"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
