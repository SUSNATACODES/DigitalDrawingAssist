<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/developerRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_canvas"
    tools:context=".DeveloperInfoActivity">

    <com.susnatacodes.digitaldrawingassist.SketchBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/developerContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/developerAppBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/developerToolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/dda_ink"
                app:title="@string/open_developer_info"
                app:titleCentered="false"
                app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/developerScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/developerEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_warm"
                    android:fontFamily="sans-serif"
                    android:textFontWeight="500"
                    tools:targetApi="28"
                    android:letterSpacing="0"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/developer_eyebrow"
                    android:textColor="@color/dda_coral"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/developerHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/card_brand_profile"
                    android:elevation="6dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:background="@drawable/avatar_susnata"
                            android:fontFamily="sans-serif"
                            android:textFontWeight="900"
                            android:textStyle="bold"
                            tools:targetApi="28"
                            android:gravity="center"
                            android:text="@string/developer_avatar"
                            android:textColor="@color/white"
                            android:textSize="30sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:textFontWeight="900"
                                android:textStyle="bold"
                                tools:targetApi="28"
                                android:text="@string/developer_name"
                                android:textColor="@color/white"
                                android:textSize="22sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/developer_role"
                                android:textColor="@color/white_85"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/developer_bio"
                        android:textColor="@color/white_90"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/chip_dark"
                            android:gravity="center"
                            android:padding="6dp"
                            android:text="@string/developer_badge_apps"
                            android:textColor="@color/white"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/chip_dark"
                            android:gravity="center"
                            android:padding="6dp"
                            android:text="@string/developer_badge_ui"
                            android:textColor="@color/white"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/chip_dark"
                            android:gravity="center"
                            android:padding="6dp"
                            android:text="@string/developer_badge_code"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/developerLinksCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/card_link_surface"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textFontWeight="900"
                        android:textStyle="bold"
                        tools:targetApi="28"
                        android:text="@string/developer_links_title"
                        android:textColor="@color/dda_ink"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/developer_links_subtitle"
                        android:textColor="@color/dda_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/mini_tool_tile"
                        android:padding="12dp"
                        android:text="@string/developer_website_display"
                        android:textColor="@color/dda_ink"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/mini_tool_tile"
                        android:padding="12dp"
                        android:text="@string/developer_github_display"
                        android:textColor="@color/dda_ink"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/developerQualityCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/card_quality_surface"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textFontWeight="900"
                        android:textStyle="bold"
                        tools:targetApi="28"
                        android:text="@string/developer_quality_title"
                        android:textColor="@color/dda_ink"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/developer_quality_body"
                        android:textColor="@color/dda_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDeveloperWebsite"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/button_primary"
                    android:drawableStart="@drawable/ic_open_in_new"
                    android:drawableTint="@color/white"
                    android:drawablePadding="10dp"
                    android:fontFamily="sans-serif"
                    android:textFontWeight="500"
                    tools:targetApi="28"
                    android:text="@string/open_website"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDeveloperGithub"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/button_link"
                    android:drawableStart="@drawable/ic_open_in_new"
                    android:drawableTint="@color/dda_ink"
                    android:drawablePadding="10dp"
                    android:fontFamily="sans-serif"
                    android:textFontWeight="500"
                    tools:targetApi="28"
                    android:text="@string/open_github"
                    android:textAllCaps="false"
                    android:textColor="@color/dda_ink"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDeveloperShare"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_secondary"
                        android:drawableStart="@drawable/ic_share"
                        android:drawableTint="@color/dda_ink"
                        android:drawablePadding="8dp"
                        android:fontFamily="sans-serif"
                        android:textFontWeight="500"
                        tools:targetApi="28"
                        android:text="@string/share_profile"
                        android:textAllCaps="false"
                        android:textColor="@color/dda_ink"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDeveloperCopy"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_secondary"
                        android:drawableStart="@drawable/ic_copy"
                        android:drawableTint="@color/dda_ink"
                        android:drawablePadding="8dp"
                        android:fontFamily="sans-serif"
                        android:textFontWeight="500"
                        tools:targetApi="28"
                        android:text="@string/copy_links"
                        android:textAllCaps="false"
                        android:textColor="@color/dda_ink"
                        android:textSize="14sp" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDeveloperBack"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_ghost"
                    android:fontFamily="sans-serif"
                    android:textFontWeight="500"
                    tools:targetApi="28"
                    android:text="@string/back_to_studio"
                    android:textAllCaps="false"
                    android:textColor="@color/dda_ink"
                    android:textSize="15sp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</FrameLayout>
