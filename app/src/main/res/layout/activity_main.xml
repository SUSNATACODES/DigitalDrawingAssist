<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_canvas">

    <com.susnatacodes.digitaldrawingassist.SketchBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="34dp"
            android:paddingEnd="24dp"
            android:paddingBottom="30dp">

            <TextView
                android:id="@+id/mainEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_warm"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:text="@string/main_eyebrow"
                android:textColor="@color/dda_coral"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/mainTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0"
                android:lineSpacingExtra="2dp"
                android:text="@string/app_name"
                android:textColor="@color/dda_ink"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/mainSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/main_subtitle"
                android:textColor="@color/dda_muted"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/drawingEdgePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/card_deep"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/drawing_edge_teaser_title"
                    android:textColor="@color/white"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/drawing_edge_teaser_body"
                    android:textColor="#CDECECF0"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDrawingEdge"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/button_primary"
                    android:drawableStart="@android:drawable/ic_menu_edit"
                    android:drawablePadding="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/open_drawing_edge"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/heroPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/card_surface"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="214dp"
                    android:background="@drawable/bg_preview_stage"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/selectedPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="false"
                        android:background="@drawable/bg_preview_empty"
                        android:contentDescription="@string/preview_title"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_gallery" />

                    <com.susnatacodes.digitaldrawingassist.ReferenceGlowView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:id="@+id/imageStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/reference_empty"
                    android:textColor="@color/dda_ink"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toolboxPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/card_toolbox"
                android:elevation="5dp"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/toolbox_title"
                    android:textColor="@color/dda_ink"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/toolbox_subtitle"
                    android:textColor="@color/dda_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/mini_tool_tile"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="@string/toolbox_grid"
                        android:textColor="@color/dda_ink"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/mini_tool_tile"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="@string/toolbox_boost"
                        android:textColor="@color/dda_ink"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/mini_tool_tile"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="@string/toolbox_nudge"
                        android:textColor="@color/dda_ink"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/mini_tool_tile"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="@string/toolbox_draw"
                        android:textColor="@color/dda_ink"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/developerSpotlight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/card_developer_spotlight"
                android:elevation="5dp"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/avatar_susnata"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/developer_avatar"
                    android:textColor="@color/white"
                    android:textSize="25sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/developer_spotlight_title"
                        android:textColor="@color/dda_ink"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/developer_spotlight_body"
                        android:textColor="@color/dda_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/featureStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_outline"
                    android:padding="13dp"
                    android:text="@string/feature_drag_zoom"
                    android:textColor="@color/dda_ink"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/chip_outline"
                    android:padding="13dp"
                    android:text="@string/feature_opacity_lock"
                    android:textColor="@color/dda_ink"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/chip_outline"
                    android:padding="13dp"
                    android:text="@string/feature_reset_center"
                    android:textColor="@color/dda_ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSelect"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/button_secondary"
                android:drawableStart="@android:drawable/ic_menu_gallery"
                android:drawablePadding="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/select_image"
                android:textAllCaps="false"
                android:textColor="@color/dda_ink"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_primary"
                android:drawableStart="@android:drawable/ic_menu_upload"
                android:drawablePadding="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/start_overlay"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGuide"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_ghost"
                android:drawableStart="@android:drawable/ic_menu_help"
                android:drawablePadding="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/open_creative_guide"
                android:textAllCaps="false"
                android:textColor="@color/dda_ink"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDeveloper"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_link"
                android:drawableStart="@android:drawable/ic_menu_info_details"
                android:drawablePadding="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/open_developer_info"
                android:textAllCaps="false"
                android:textColor="@color/dda_ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/startHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/start_hint_empty"
                android:textColor="@color/dda_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
