<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".PermissionActivity">

    <LinearLayout
        android:id="@+id/permissionContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/permissionScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/permissionScrollContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/permissionEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_warm"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.08"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/permission_eyebrow"
                    android:textColor="@color/dda_coral"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/permissionHeroIconFrame"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/brutal_button_yellow"
                    android:contentDescription="@string/app_name"
                    android:importantForAccessibility="no">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav_canvas"
                        app:tint="@color/black" />
                </FrameLayout>

                <TextView
                    android:id="@+id/permissionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="-0.02"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/permission_title"
                    android:textColor="@color/black"
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:textFontWeight="900"
                    tools:targetApi="28" />

                <TextView
                    android:id="@+id/permissionIntro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/permission_intro"
                    android:textColor="@color/dda_muted"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/permissionStepsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/brutal_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/brutal_button_green"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="0.06"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="@string/permission_card_eyebrow"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/permissionCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/permission_card_title"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/black"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/brutal_button_pink"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                        android:text="@string/permission_step_number_one"
                            android:textColor="@color/black"
                        android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/permission_step_one"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/brutal_button_pink"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                        android:text="@string/permission_step_number_two"
                            android:textColor="@color/black"
                        android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/permission_step_two"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/brutal_button_pink"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                        android:text="@string/permission_step_number_three"
                            android:textColor="@color/black"
                        android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/permission_step_three"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/permissionPrivacyNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/permission_privacy_note"
                    android:textColor="@color/dda_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/permissionActionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGrantPermission"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/button_primary"
                android:fontFamily="sans-serif"
                android:minHeight="56dp"
                android:text="@string/permission_open_settings"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textFontWeight="700"
                tools:targetApi="28" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:text="@string/permission_return_hint"
                android:textColor="@color/dda_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</merge>
