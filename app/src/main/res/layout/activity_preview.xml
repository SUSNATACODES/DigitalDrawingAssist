<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_canvas">

    <com.susnatacodes.digitaldrawingassist.SketchBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="30dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0"
            android:text="@string/preview_title"
            android:textColor="@color/dda_ink"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/previewStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/preview_ready"
            android:textColor="@color/dda_muted"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/previewStage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="22dp"
            android:layout_weight="1"
            android:background="@drawable/bg_preview_stage"
            android:elevation="8dp"
            android:padding="14dp">

            <ImageView
                android:id="@+id/previewImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_preview_empty"
                android:contentDescription="@string/preview_title"
                android:scaleType="fitCenter" />

            <com.susnatacodes.digitaldrawingassist.ReferenceGlowView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif-medium"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/dda_ink"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDone"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/button_primary"
                android:fontFamily="sans-serif-medium"
                android:text="@string/preview_use_image"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
