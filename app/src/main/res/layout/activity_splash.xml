<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".SplashActivity">

    <com.susnatacodes.digitaldrawingassist.SketchBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/splashScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <!-- fillViewport expands this frame to center the card when space allows; short screens can scroll. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/splashCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/brutal_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="24dp"
                android:paddingEnd="22dp"
                android:paddingBottom="22dp"
                tools:ignore="UselessParent">

                <TextView
                    android:id="@+id/splashBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_warm"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.08"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/splash_brand"
                    android:textColor="@color/dda_coral"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/splashLogo"
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:layout_marginTop="18dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_app_logo" />

                <TextView
                    android:id="@+id/splashTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:letterSpacing="-0.02"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/splash_title"
                    android:textColor="@color/black"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textFontWeight="900"
                    tools:targetApi="28" />

                <TextView
                    android:id="@+id/splashSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:letterSpacing="0.04"
                    android:text="@string/splash_tagline"
                    android:textColor="@color/dda_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/splashProgressText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:text="@string/splash_progress"
                    android:textColor="@color/dda_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/splashProgressContainer"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/brutal_input"
                    android:padding="4dp">

                    <View
                        android:id="@+id/splashProgressBar"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@color/brutal_green"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</merge>
