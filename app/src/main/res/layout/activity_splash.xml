<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brutal_cream"
    tools:context=".SplashActivity">

    <!-- Animated Backdrop -->
    <com.susnatacodes.digitaldrawingassist.SketchBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Center Brutalist Splash Card -->
    <LinearLayout
        android:id="@+id/splashCard"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/brutal_card"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- Top Badge -->
        <TextView
            android:id="@+id/splashBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/brutal_button_pink"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.08"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="SUSNATA CODES"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textFontWeight="900"
            tools:targetApi="28" />

        <!-- Icon Container -->
        <FrameLayout
            android:id="@+id/splashIconFrame"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp">

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_app_logo" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:lineSpacingExtra="2dp"
            android:text="DIGITAL DRAWING\nASSIST."
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textFontWeight="900"
            tools:targetApi="28" />

        <TextView
            android:id="@+id/splashSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:text="TRACE · SKETCH · OVERLAY"
            android:textColor="@color/dda_muted"
            android:textSize="11sp" />

        <!-- Brutalist Loading Bar -->
        <FrameLayout
            android:id="@+id/splashProgressContainer"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/brutal_input">

            <View
                android:id="@+id/splashProgressBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/brutal_green" />

            <TextView
                android:id="@+id/splashProgressText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:text="LOADING ENGINE..."
                android:textColor="@color/black"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textFontWeight="900"
            tools:targetApi="28" />
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
