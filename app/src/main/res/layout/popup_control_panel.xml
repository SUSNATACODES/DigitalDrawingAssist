<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:id="@+id/controlPanelContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_control_panel"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <!-- Header: Title and Mode Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvControlPanelTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:text="@string/cp_title"
                android:textColor="@color/black"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvModeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/brutal_button_green"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/cp_mode_draw"
                android:textColor="@color/black"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Section: CREATIVE MODES -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
            android:paddingStart="2dp"
            android:paddingTop="8dp"
            android:paddingEnd="2dp"
            android:paddingBottom="8dp"
            android:text="@string/cp_section_presets"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <!-- Presets Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="3"
            tools:ignore="ButtonBarStyle">

            <Button
                android:id="@+id/btnPresetTrace"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/cp_preset_trace"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="13sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />

            <Button
                android:id="@+id/btnPresetLineArt"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/cp_preset_line_art"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="13sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />

            <Button
                android:id="@+id/btnPresetDarkCanvas"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/cp_preset_dark_canvas"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="13sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />
        </LinearLayout>

        <!-- Presets Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="3"
            tools:ignore="ButtonBarStyle">

            <Button
                android:id="@+id/btnPresetClean"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/cp_preset_clean"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="13sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />

            <Button
                android:id="@+id/btnQuickFit"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/cp_quick_fit"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="13sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />

            <Button
                android:id="@+id/btnQuickCenter"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/cp_quick_center"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="13sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />
        </LinearLayout>

        <!-- Hold Peek Button -->
        <Button
            android:id="@+id/btnPeekOriginal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/brutal_button_pink"
            android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/cp_peek_original"
            android:textAllCaps="true"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <!-- Section: PLACE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
            android:paddingStart="2dp"
            android:paddingTop="8dp"
            android:paddingEnd="2dp"
            android:paddingBottom="8dp"
            android:text="@string/cp_section_place"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <!-- Drag Switch Row -->
        <LinearLayout
            android:id="@+id/rowDrag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/brutal_input"
            android:clickable="true"
            android:contentDescription="@string/cp_drag"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                    android:text="@string/cp_drag"
                    android:textColor="@color/black"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
        android:textFontWeight="500"
        tools:targetApi="28"
                    android:text="@string/cp_drag_sub"
                    android:textColor="@color/dda_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnToggleDrag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:background="@drawable/brutal_button_green"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp"
                android:text="@string/cp_toggle_off"
                android:textColor="@color/black"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Zoom Switch Row -->
        <LinearLayout
            android:id="@+id/rowZoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/brutal_input"
            android:clickable="true"
            android:contentDescription="@string/cp_zoom"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                    android:text="@string/cp_zoom"
                    android:textColor="@color/black"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
        android:textFontWeight="500"
        tools:targetApi="28"
                    android:text="@string/cp_zoom_sub"
                    android:textColor="@color/dda_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnToggleZoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:background="@drawable/brutal_button_green"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp"
                android:text="@string/cp_toggle_off"
                android:textColor="@color/black"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Resize Switch Row -->
        <LinearLayout
            android:id="@+id/rowResize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/brutal_input"
            android:clickable="true"
            android:contentDescription="@string/cp_resize"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                    android:text="@string/cp_resize"
                    android:textColor="@color/black"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
        android:textFontWeight="500"
        tools:targetApi="28"
                    android:text="@string/cp_resize_sub"
                    android:textColor="@color/dda_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnToggleResize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:background="@drawable/brutal_button_green"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp"
                android:text="@string/cp_toggle_off"
                android:textColor="@color/black"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Rotation Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="3"
            tools:ignore="ButtonBarStyle">

            <Button
                android:id="@+id/btnRotateLeft"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/cp_rotate_left"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />

            <Button
                android:id="@+id/btnRotateReset"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/cp_rotate_reset"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />

            <Button
                android:id="@+id/btnRotateRight"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/cp_rotate_right"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />
        </LinearLayout>

        <!-- Mirror / Quick Reset Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="2"
            tools:ignore="ButtonBarStyle">

            <Button
                android:id="@+id/btnMirror"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/cp_mirror"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />

            <Button
                android:id="@+id/btnQuickReset"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/cp_quick_reset"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />
        </LinearLayout>

        <!-- Section: LOOK -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
            android:paddingStart="2dp"
            android:paddingTop="8dp"
            android:paddingEnd="2dp"
            android:paddingBottom="8dp"
            android:text="@string/cp_section_look"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <!-- Opacity Slider Container -->
        <LinearLayout
            android:id="@+id/containerOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/brutal_input"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                    android:text="@string/cp_transparency"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvOpacityValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    tools:text="82%" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbOpacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cp_transparency"
                android:paddingTop="12dp"
                android:progressTint="@color/black"
                android:thumbTint="@color/black" />
        </LinearLayout>

        <!-- Size Slider Container -->
        <LinearLayout
            android:id="@+id/containerSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/brutal_input"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                    android:text="@string/cp_size"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    tools:text="100%" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cp_size"
                android:paddingTop="12dp"
                android:progressTint="@color/black"
                android:thumbTint="@color/black" />
        </LinearLayout>

        <!-- Filters Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="3"
            tools:ignore="ButtonBarStyle">

            <Button
                android:id="@+id/btnGrayscale"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/cp_grayscale"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />

            <Button
                android:id="@+id/btnContrast"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/cp_contrast"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />

            <Button
                android:id="@+id/btnInvert"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/cp_invert"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />
        </LinearLayout>

        <!-- Guide Mode Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="3"
            tools:ignore="ButtonBarStyle">

            <Button
                android:id="@+id/btnGuideOff"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/cp_guide_off"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />

            <Button
                android:id="@+id/btnGuideGrid"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/cp_guide_grid"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />

            <Button
                android:id="@+id/btnGuideThirds"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/cp_guide_thirds"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />
        </LinearLayout>

        <!-- Section: FINISH -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
            android:paddingStart="2dp"
            android:paddingTop="8dp"
            android:paddingEnd="2dp"
            android:paddingBottom="8dp"
            android:text="@string/cp_section_finish"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <!-- Finish Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="3"
            tools:ignore="ButtonBarStyle">

            <Button
                android:id="@+id/btnDrawMode"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/brutal_button_yellow"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/cp_draw_mode"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="13sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />

            <Button
                android:id="@+id/btnDone"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/cp_done"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="13sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />

            <Button
                android:id="@+id/btnClose"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/brutal_button_pink"
                android:fontFamily="sans-serif"
        android:textFontWeight="900"
        android:textStyle="bold"
        tools:targetApi="28"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/cp_close"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="13sp"
                tools:ignore="ButtonBarStyle,ButtonStyle" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
