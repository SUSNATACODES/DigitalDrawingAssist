<resources>
    <style name="Base.Theme.DigitalDrawingAssist" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dda_primary</item>
        <item name="colorSecondary">@color/dda_teal</item>
        <item name="colorTertiary">@color/dda_sun</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/dda_bg_bottom</item>
        <item name="android:statusBarColor">@color/dda_bg_top</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.DigitalDrawingAssist" parent="Base.Theme.DigitalDrawingAssist" />

    <style name="DrawingEdgeToolButton">
        <item name="android:layout_width">92dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="DrawingEdgeActionButton">
        <item name="android:layout_width">92dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="DrawingEdgeLayerButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
